# Node / Capacitor
node_modules/

# Web staging folder — regenerated by scripts/prep-web.js on every build
www/

# Android build outputs + gradle caches (regenerated on every build)
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/.idea/
android/captures/
android/*.iml
android/app/*.iml

# Signing keys — NEVER commit these. Keep key.properties + the .jks file
# out of the repo. Store copies in an offline safe (password manager,
# encrypted USB, safe deposit box).
android/key.properties
*.jks
*.keystore

# OS junk
.DS_Store
Thumbs.db
desktop.ini
